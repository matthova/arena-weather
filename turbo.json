{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "@arena-weather/web#deploy": {
      "cache": false,
      // The web Worker binds to the API Worker by name, so the API has to exist first.
      "dependsOn": ["build", "@arena-weather/api#deploy"]
    }
  }
}
