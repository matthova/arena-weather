{
  "name": "arena-weather",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "deploy": "turbo run deploy",
    "db:migrate": "pnpm --filter @arena-weather/api db:migrate",
    "db:migrate:remote": "pnpm --filter @arena-weather/api db:migrate:remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
